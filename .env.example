# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# PUBLIC_DATA_API_KEY: 공공데이터포털(data.go.kr) 일반 인증키 (Decoding 키 권장)
# 소상공인시장진흥공단 상가(상권)정보 API 및 국토교통부 실거래가 API 공용 인증키
PUBLIC_DATA_API_KEY=""

# REB_API_KEY: 한국부동산원(R-ONE) Open API 인증키
REB_API_KEY=""

# SCHOOL_INFO_API_KEY: 학교알리미(schoolinfo.go.kr) Open API 인증키
SCHOOL_INFO_API_KEY=""

# KAKAO_JAVASCRIPT_API_KEY: 카카오맵 JavaScript SDK 인증키
KAKAO_JAVASCRIPT_API_KEY=""

# KAKAO_REST_API_KEY: 카카오 로컬 주소-좌표 변환(Geocoding) REST API 인증키
KAKAO_REST_API_KEY=""

# SEOUL_OPEN_DATA_API_KEY: 서울 열린데이터 광장(data.seoul.go.kr) Open API 인증키
SEOUL_OPEN_DATA_API_KEY=""
